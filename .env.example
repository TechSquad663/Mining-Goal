# =========================================================================
# COALINTELLIGENCE AI — Environment Variables
# =========================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# AI Engine Mode: 'mock' (Default out-of-the-box zero config) or 'production'
AI_MODE=mock

# Optional Production Database Connection (PostgreSQL with pgvector)
# DATABASE_URL=postgresql://coaladmin:securepassword@localhost:5432/coalintelligence_db

# Production AI / LLM Provider Keys (Used only when AI_MODE=production)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# OCR Engine: 'tesseract' or 'textract' or 'cloudvision'
OCR_ENGINE=tesseract
